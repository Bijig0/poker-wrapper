# Machine-local settings for the Poker Wrapper stack.
# Copy this file to config\local.env (untracked) and fill in only what auto-detection gets wrong.
# Blank = auto-detect (see config\env.ps1 for where each one is looked for).

# --- tools ---
# bun.exe: PATH, then %LOCALAPPDATA%\Programs\node-v*\node_modules\bun\bin, npm global, ~\.bun\bin
BUN=
# the Python the wrapper and chart server run in (default: <repo>\aof-model\.venv\Scripts\python.exe)
PYTHON=
# the ZIP-installed Node folder (default: newest %LOCALAPPDATA%\Programs\node-v*-win-x64)
NODE_DIR=
# Git for Windows install folder (default: %ProgramFiles%\Git)
GIT_DIR_WIN=

# --- data the study API arms at start (defaults are the NL25 exports in analysis\pipeline\limp_study) ---
EXPLOIT_CHART=
POOL_MODEL=
# parsed HRC trees kept resident by the chart server on :8777
HRC_UI_DOC_CACHE_MAX=6

# --- where the records live (gto-trainer/DATA-ROOT-PLAN.md) ---
# One folder for every runtime record: the central poker.sqlite (hands, answers, stored chains, GTO Wizard requests,
# poller events, sessions...) plus the logs, caches and recordings beside it. Blank = <repo>\data for the database and
# the old folders (gto-trainer\apps\api\data, ignition-study-wrapper\data and \debug) for the rest. Change it with the
# API and the wrapper stopped: on their next start the old files are folded in. Every launcher passes it on.
POKER_DATA_DIR=

# --- you ---
# your CoinPoker screen name. Normally leave blank: the reader learns it from the client's log ("Login on SFS
# with <name>"). Set it only to pin a different account.
CP_HERO=

# Where updates come from (setup\update.ps1 and the setup page banner). Leave blank for the normal channel.
PW_CHANNEL=
